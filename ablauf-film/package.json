{
  "name": "ablauf-film",
  "version": "1.0.0",
  "description": "Der Ablauf in 30 Sekunden: vom Satz an den Agenten bis zum Post, als Animation mit echten Sounds aus dem Kit (Remotion)",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/studio": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "vorbereiten": "node scripts/vorbereiten.mjs",
    "typen": "tsc --noEmit",
    "render": "remotion render Ablauf out/ablauf.mp4 --image-format=png --codec=h264 --crf=20 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "ton": "remotion render Ablauf out/ton.wav --codec=wav",
    "vorschau": "node scripts/vorschau.mjs"
  }
}
